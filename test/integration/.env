# Test-only values for the throwaway integration server. Nothing here is a
# real secret; the server only ever listens on 127.0.0.1.
# Single source of truth: docker compose reads this file, and so do the Python
# scripts (seed/kosync.py load_env) — keep plain KEY=VALUE lines, no quoting.
APP_PORT=3999
APP_URL=http://127.0.0.1:3999
CLIENT_URL=http://127.0.0.1:3999
POSTGRES_USER=bookorbit
POSTGRES_PASSWORD=bookorbit-test
POSTGRES_DB=bookorbit
JWT_SECRET=crossink-integration-jwt-secret-0000000000000000
SETUP_BOOTSTRAP_TOKEN=crossink-integration-setup-token
